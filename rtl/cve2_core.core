name: "openhwgroup:cve2:cve2_core:0.1"
description: "CVE2 CPU Core Components"

filesets:

  files_chief_pkg: 
    files: 
      - rtl/chief/chief_pkg.sv
    file_type: systemVerilogSource

  files_mac_fp4: 
    depend:
      - openhwgroup:cve2:cve2_pkg
    files:  
      - rtl/chief/mac_cell_fp4/sat16_adder.sv
      - rtl/chief/mac_cell_fp4/fp4_mul_int9.sv
      - rtl/chief/mac_cell_fp4/mac_cell.sv
    file_type: systemVerilogSource

  files_mac_int4: 
    depend:
      - openhwgroup:cve2:cve2_pkg
    files:  
      - rtl/chief/mac_cell_int4/sat16_adder.sv
      - rtl/chief/mac_cell_int4/int4_mul_int8.sv
      - rtl/chief/mac_cell_int4/mac_cell.sv
    file_type: systemVerilogSource

  files_chief:
    depend:
      - openhwgroup:cve2:cve2_pkg
    files:
      - rtl/chief/mac_accum_bram.sv
      - rtl/chief/parameterized_adder.sv
      - rtl/chief/mac_scale_fsm.sv
      - rtl/chief/mac_controller.sv
      - rtl/chief/mac_array.sv
      - rtl/chief/bf16_to_fp4.sv
      - rtl/chief/cve2_cf_mac_unit.sv
      - rtl/chief/cve2_vec_regfile.sv
      - rtl/chief/cve2_vec_unit.sv
    file_type: systemVerilogSource

  # Scale unit implementations (mutually exclusive: module names overlap).
  # Default is the scale_array; pass `--flag=legacy_scale` to fusesoc
  # (or SCALE_UNIT=legacy to make) for the original per-lane e4m3_scale.
  files_scale_array:
    depend:
      - openhwgroup:cve2:cve2_pkg
    files:
      - rtl/chief/priority_enc.sv
      - rtl/chief/scale_array/round_rne.sv
      - rtl/chief/scale_array/bf16_accumulate.sv
      - rtl/chief/scale_array/e4m3_broadcast_mul.sv
      - rtl/chief/scale_array/e4m3_scale.sv
      - rtl/chief/scale_array/scale_accum_array.sv
    file_type: systemVerilogSource

  files_scale_legacy:
    depend:
      - openhwgroup:cve2:cve2_pkg
    files:
      - rtl/chief/fp4_e4m3_scale_mul.sv
      - rtl/chief/e4m3_scale.sv
      - rtl/chief/int16_to_bf16.sv
      - rtl/chief/bf16_accumulate.sv
    file_type: systemVerilogSource

  files_rtl:
    depend:
      - lowrisc:prim:assert
      - openhwgroup:cve2:cve2_pkg
      - lowrisc:dv:dv_fcov_macros
    files:
      - rtl/cve2_alu.sv
      - rtl/cve2_branch_predict.sv
      - rtl/cve2_compressed_decoder.sv
      - rtl/cve2_controller.sv
      - rtl/cve2_cs_registers.sv
      - rtl/cve2_csr.sv
      - rtl/cve2_counter.sv
      - rtl/cve2_decoder.sv
      - rtl/cve2_ex_block.sv
      - rtl/cve2_fetch_fifo.sv
      - rtl/cve2_id_stage.sv
      - rtl/cve2_if_stage.sv
      - rtl/cve2_load_store_unit.sv
      - rtl/cve2_multdiv_fast.sv
      - rtl/cve2_multdiv_slow.sv
      - rtl/cve2_prefetch_buffer.sv
      - rtl/cve2_pmp.sv
      - rtl/cve2_wb.sv
      - rtl/cve2_core.sv
      - rtl/cve2_pmp_reset_default.svh: {is_include_file: true}
    file_type: systemVerilogSource

  files_lint_verilator:
    files:
      - lint/verilator_waiver.vlt: {file_type: vlt}

  files_lint_verible:
    files:
      - lint/verible_waiver.vbw: {file_type: veribleLintWaiver}

  files_check_tool_requirements:
    depend:
     - lowrisc:tool:check_tool_requirements

parameters:
  RVFI:
    datatype: bool
    paramtype: vlogdefine

  SYNTHESIS:
    datatype: bool
    paramtype: vlogdefine

  FPGA_XILINX:
    datatype: bool
    description: Identifies Xilinx FPGA targets to set DSP pragmas for performance counters.
    default: false
    paramtype: vlogdefine

  CHIEF_LEGACY_SCALE:
    datatype: bool
    default: false
    paramtype: vlogdefine
    description: "Build the legacy per-lane e4m3_scale instead of scale_accum_array_e4m3. Set via the legacy_scale flag."

  RV32E:
    datatype: int
    default: 0
    paramtype: vlogparam

  RV32M:
    datatype: str
    default: cve2_pkg::RV32MFast
    paramtype: vlogdefine
    description: "RV32M implementation parameter enum. See the cve2_pkg::rv32m_e enum in cve2_pkg.sv for permitted values."

targets:
  default: &default_target
    filesets:
      - tool_verilator ? (files_lint_verilator)
      - tool_veriblelint ? (files_lint_verible)
      - files_chief_pkg
      - files_chief
      - legacy_scale ? (files_scale_legacy)
      - "!legacy_scale ? (files_scale_array)"
      - files_mac_fp4  
      - files_rtl
    toplevel: cve2_core
    parameters:
      - tool_vivado ? (FPGA_XILINX=true)
      - legacy_scale ? (CHIEF_LEGACY_SCALE=true)
  
  lint_int4: 
    filesets:
      - tool_verilator ? (files_lint_verilator)
      - tool_veriblelint ? (files_lint_verible)
      - files_chief_pkg
      - files_chief
      - legacy_scale ? (files_scale_legacy)
      - "!legacy_scale ? (files_scale_array)"
      - files_mac_int4  
      - files_rtl
    toplevel: cve2_core
    parameters:
      - tool_vivado ? (FPGA_XILINX=true)
      - legacy_scale ? (CHIEF_LEGACY_SCALE=true)

  lint:
    <<: *default_target
    parameters:
      - SYNTHESIS=true
      - RVFI=true
      - legacy_scale ? (CHIEF_LEGACY_SCALE=true)
    default_tool: verilator
    tools:
      verilator:
        mode: lint-only
        verilator_options:
          - "-Wall"
          # RAM primitives wider than 64bit (required for ECC) fail to build in
          # Verilator without increasing the unroll count (see Verilator#1266)
          - "--unroll-count 72"
  format:
    filesets:
      - files_chief_pkg
      - files_mac_fp4
      - files_chief
      - legacy_scale ? (files_scale_legacy)
      - "!legacy_scale ? (files_scale_array)"
      - files_rtl
    parameters:
      - SYNTHESIS=true
      - RVFI=true
      - legacy_scale ? (CHIEF_LEGACY_SCALE=true)
    default_tool: veribleformat
    toplevel: cve2_core
    tools:
      veribleformat:
        verible_format_args:
          - "--inplace"
