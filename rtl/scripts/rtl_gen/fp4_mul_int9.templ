    !!NOTE!! THIS FILE IS AUTOGENERATED
             FROM scripts/rtl_gen/fp4_mul_int9.templ.

    DO NOT CHANGE THE .sv FILE DIRECTLY
=====================================================
**/

`timescale 1ns/1ps

/**
    Computes FP4 x FP4 and quantizes the product 
    into {sign, UINT8} representation directly using LUTs.
**/
module fp4_mul_int9
import fp4_pkg::*; (
    input fp4_e2m1_t fp4_a_i, 
    input fp4_e2m1_t fp4_b_i,
    output logic sign_o,
    output logic [7:0] u8_mag_o
); 

/* Sign bit calculation */
assign sign_o = fp4_a_i.sign ^ fp4_b_i.sign;

/* 
    Lookup table for the multiplication.
    Index is constructed as 
    {fp4_a_mag, fp4_b_mag}
    (excluding the sign).

    This maps the inputs to a Q6.2 UNSIGNED
    representation.

    In other words, interpreting the results as U8
    is just:
    u8_mag_o = v(mag(fp4_a_i)) * v(mag(fp4_b_i)) * 4 

    Where v(x) denotes **real** value of x. 
 */
localparam logic [7:0] outLUT[0:63] = '{
[[REPLACE fp4_lut]]
};

assign u8_mag_o[7:0] = outLUT[{fp4_a_i[2:0], fp4_b_i[2:0]}];

endmodule; 
