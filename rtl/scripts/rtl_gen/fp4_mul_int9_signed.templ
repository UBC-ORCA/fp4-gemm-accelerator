`timescale 1ns/1ps

/**
    Computes FP4 x FP4 and quantizes the product
    into a signed INT9 (two's complement) representation
    directly using a LUT.
**/
module fp4_mul_int9_signed
import fp4_pkg::*; (
    input  fp4_e2m1_t fp4_a_i,
    input  fp4_e2m1_t fp4_b_i,
    output logic signed [8:0] product_o
);

/*
    Lookup table for the multiplication.
    Index is constructed as
    {fp4_a_i, fp4_b_i}
    (full 4-bit code, sign included).

    This maps the inputs directly to a signed Q7.2
    two's-complement representation.

    In other words, interpreting the result as INT9 is:
    product_o = v(fp4_a_i) * v(fp4_b_i) * 4

    Where v(x) denotes **real** (signed) value of x.
 */
localparam logic signed [8:0] outLUT[0:255] = '{
[[REPLACE fp4_lut]]
};

assign product_o = outLUT[{fp4_a_i, fp4_b_i}];

endmodule;
